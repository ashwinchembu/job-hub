# Required only for the AI code-review button. Keep the real key in `.env.local`.
OPENAI_API_KEY=

# Optional. GPT-5.6 Sol is the current recommended high-capability model.
OPENAI_MODEL=gpt-5.6-sol

# Required for agent/backend synchronization scripts.
JOB_HUB_BASE_URL=https://your-job-hub.example.com
# Keep the real token only in .env.local or the calling process environment.
JOB_HUB_SIWC_BYPASS_TOKEN=

# Private artifacts and recordings must remain in an ignored local path.
JOB_HUB_PRIVATE_ROOT=private-data/job-hub

# Optional: private local workbook recovery copy. Never commit the workbook.
# JOB_TRACKER_PATH=./private-data/job-tracker.xlsx
